<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UsefulAIKey.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UsefulAIKey"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="UsefulAIKey">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="16" Spacing="8">
        <ComboBox x:Name="ActionComboBox"
                  SelectionChanged="Action_SelectionChanged"
                  Header="Your Copilot key will..." Width="200">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:ActionOption">
                    <TextBlock Text="{x:Bind Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Search box: filters the list below as you type. -->
        <AutoSuggestBox x:Name="SearchBox"
                        Width="400"
                        PlaceholderText="Search apps..."
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" />

        <!-- The app list. IsItemClickEnabled makes each row a button (raises
             ItemClick); we handle that to pin the chosen app to the top. -->
        <ListView x:Name="AppsList"
                  Width="400" Height="360"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="AppsList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:AppItem">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo binds OneWay because it loads asynchronously. -->
                        <Image Grid.Column="0" Width="24" Height="24"
                               Source="{x:Bind Logo, Mode=OneWay}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Pin marker: shown only when this app is the saved one. -->
                        <FontIcon Grid.Column="2"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE840;"
                                  FontSize="14"
                                  Visibility="{x:Bind PinIndicatorVisibility, Mode=OneWay}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Window>
