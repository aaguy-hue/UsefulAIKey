import "ActionOption.idl"; // for ActionKind

namespace UsefulAIKey
{
    // Result of trying to save settings
    // It's declared here in IDL instead of an enum so it becomes a WinRT type
    // For IAsyncOperation<T>
    enum SavingError
    {
        None,             // saved successfully
        ReadError,        // couldn't read the existing settings file
        ParseError,       // couldn't parse the existing settings file
        CapacityExceeded, // the new document would exceed the size cap
        WriteError,       // couldn't write the file back to disk
    };

    // The persisted "what should the Copilot key do" choice, loaded at startup.
    // A WinRT struct so it can be the T in IAsyncOperation<T>. Structs may hold
    // enums and strings (but NOT runtimeclasses like AppItem) -- which is why the
    // payload is a plain string path/url rather than an AppItem.
    struct SavedSelection
    {
        ActionKind Kind;  // app / website / file
        String Command;   // the app path, url, or file path ("" when nothing is saved)
    };

    // One user-added app in the persisted custom-apps list. A WinRT struct (holds
    // only strings) so it can be the T in IAsyncOperation<IVector<CustomApp>>.
    // These are the apps the user picked via "Browse for app..."; they persist
    // across launches and get merged back into the picker on load.
    struct CustomApp
    {
        String Name;  // display name shown in the list
        String Path;  // full path to the target executable
    };
}
